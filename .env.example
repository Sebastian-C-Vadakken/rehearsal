# Copy to .env and fill in.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs on Token Factory. Leave blank to auto-detect Nemotron models from /models
# (run `python scripts/list_models.py` to see what is available).
NANO_MODEL=
SUPER_MODEL=
ULTRA_MODEL=

# Price per 1M tokens (USD). Used for the router panel estimate and the daily budget ceiling.
# Defaults are Token Factory list prices for the Nemotron 3 models; check the console if they change.
NANO_PRICE_IN=0.06
NANO_PRICE_OUT=0.24
SUPER_PRICE_IN=0.30
SUPER_PRICE_OUT=0.90
ULTRA_PRICE_IN=1.00
ULTRA_PRICE_OUT=3.00

# Set to 1 to run without any API calls (canned responses, for UI development).
MOCK_LLM=0

# Public demo protection: POST /api/* requests per visitor per 10 min, and for everyone per hour.
RATE_PER_IP=60
RATE_GLOBAL=600
# Estimated spend allowed per UTC day before the demo shows "demo budget reached".
DAILY_BUDGET_USD=3.00
# User turns per round, and model calls per session (including replays).
MAX_TURNS=14
MAX_SESSION_CALLS=80
