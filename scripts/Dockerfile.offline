# Same as ../Dockerfile, but installs from pre-downloaded Linux wheels in .wheels/
# (workaround for slow PyPI access inside Docker Desktop). See NEXT_STEPS.md.
FROM python:3.12-slim
WORKDIR /srv
COPY requirements.txt .
COPY .wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links /wheels -r requirements.txt
COPY app app
COPY scenarios scenarios
COPY static static
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
